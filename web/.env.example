# ─── Base de données ──────────────────────────────────────────────────────
# Dev local (avec docker-compose -f docker-compose.dev.yml up postgres) :
DATABASE_URL="postgresql://pairs:pairs_dev_password@localhost:5432/pairs?schema=public"
# Prod : remplacé par docker-compose.yml ou ton hébergeur managé.

# ─── NextAuth ─────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Génère un secret robuste : openssl rand -base64 32
NEXTAUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"

# ─── Stripe ───────────────────────────────────────────────────────────────
# Clés test sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ─── Public site URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Emails transactionnels (Resend) ──────────────────────────────────────
# Crée un compte sur https://resend.com (3000 emails/mois gratuits)
# Sans clé, l'app fonctionne en mode "mock" : les emails sont loggés en console.
RESEND_API_KEY=""
# Expéditeur par défaut. Doit être un domaine vérifié dans Resend en prod.
# En dev, tu peux utiliser onboarding@resend.dev (limité à ton propre email).
EMAIL_FROM="Pairs <onboarding@resend.dev>"

# ─── DEV GATE (mot de passe global) ───────────────────────────────────────
# Mettre SITE_LOCK=1 pour bloquer tout le site derrière un mot de passe.
# Quand SITE_LOCK=0 (ou absent), le site est public.
SITE_LOCK="0"
# Mot de passe d'accès quand SITE_LOCK=1. Change-le impérativement en prod.
SITE_LOCK_PASSWORD="pairs-en-construction-2026"

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  hashedPassword   String?
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  orders           Order[]
  reviews          Review[]
  quizResponses    QuizResponse[]
  subscriptions    Subscription[]
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  description  String
  priceCents   Int
  subscriptionPriceCents Int?
  imageUrl     String
  capsules     Int      // nombre de gélules par pot
  servingSize  String   // ex: "2 gélules / jour"
  category     String   // cycle | energy | sleep | skin | immunity | hormones
  goals        String   // CSV: "energy,immunity"
  featured     Boolean  @default(false)
  ingredients  Ingredient[]
  reviews      Review[]
  orderItems   OrderItem[]
  createdAt    DateTime @default(now())
}

model Ingredient {
  id          String  @id @default(cuid())
  productId   String
  name        String
  dosage      String   // ex: "200 mg"
  benefit     String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  rating     Int      // 1..5
  title      String
  body       String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Order {
  id                  String   @id @default(cuid())
  userId              String?
  email               String
  subtotalCents       Int      @default(0)
  shippingCents       Int      @default(0)
  discountCents       Int      @default(0)
  totalCents          Int
  status              String   @default("pending") // pending | paid | failed | canceled
  stripeSessionId     String?  @unique
  stripePaymentIntent String?
  createdAt           DateTime @default(now())
  items               OrderItem[]
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeSubscriptionId String   @unique
  stripePriceId        String?
  productId            String?
  status               String   // active | past_due | canceled | unpaid | trialing | incomplete
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitCents  Int
  isSubscription Boolean @default(false)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
}

model NewsletterSubscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  promoCode  String
  createdAt  DateTime @default(now())
}

model QuizResponse {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  answers   String   // JSON
  recommendedSlugs String // CSV
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

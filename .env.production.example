# ─── Production env ─ à copier vers .env.production sur le serveur ────────
# Ne JAMAIS commiter ce fichier rempli.

# ─── Domaine et HTTPS ─────────────────────────────────────────────────────
DOMAIN=pairs.fr                          # Ton vrai domaine sans https://
ACME_EMAIL=contact@pairs.fr              # Pour Let's Encrypt
NEXTAUTH_URL=https://pairs.fr
NEXT_PUBLIC_SITE_URL=https://pairs.fr

# ─── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_DB=pairs
POSTGRES_USER=pairs
# Mot de passe FORT (32+ chars). Génère avec : openssl rand -base64 32
POSTGRES_PASSWORD=changeme-strong-password-here

# ─── NextAuth ─────────────────────────────────────────────────────────────
# OBLIGATOIRE : openssl rand -base64 32
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-base64-32

# ─── Stripe (clés LIVE en prod) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Emails transactionnels (Resend) ──────────────────────────────────────
# https://resend.com → API keys. Le domaine d'envoi DOIT être vérifié (DNS).
RESEND_API_KEY=re_xxx
EMAIL_FROM="Pairs <hello@pairs.fr>"

# ─── DEV gate ─────────────────────────────────────────────────────────────
# 1 = site bloqué derrière mot de passe, 0 = public
SITE_LOCK=1
# Change-le ! Mot de passe d'accès au site en mode DEV.
SITE_LOCK_PASSWORD=pairs-construction-2026-mot-de-passe-fort
